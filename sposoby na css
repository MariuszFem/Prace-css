<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="dokumenthtml">
    <meta name="author" content="MariuszFemin">
    <title>Strona MF</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #e6e6e6;
        }

        h1 {
            color: green;
        }

        .info {
            background-color: yellow;
        }

        #ważne {
            border: 2px solid red;
        }
    </style>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <h1 style="color: blue;">Pierwsza strona MF</h1>

    <p style="font-size: 20px;">Strona stworzona na zajęciach – tekst 20px (inline)</p>

    <p class="info">To jest akapit z klasą .info</p>

    <p id="ważne"> ważny akapit z id="ważne"</p>

</body>
</html>

<!-- 
"DOCTYPE" — informacja, że strona używa HTML5
<head> — przechowuje informacje o stronie, meta tagi, linki do CSS
Meta tagi — opis, autor, itp.
-->
